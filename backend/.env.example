# ==============================================================================
# MEDORA AI - Backend Environment Configuration
# Copy this file to .env: cp backend/.env.example backend/.env
# NEVER commit your actual .env file with secrets into version control.
# ==============================================================================

# Environment mode: development | staging | production
ENVIRONMENT=development

# ------------------------------------------------------------------------------
# Database Configuration
# ------------------------------------------------------------------------------
# SQLite (Local file-based database for quick local testing):
DATABASE_URL=sqlite:///./medora.db

# PostgreSQL / Supabase (Recommended for production):
# DATABASE_URL=postgresql+psycopg://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# Document storage directory
UPLOAD_DIR=./uploads

# ------------------------------------------------------------------------------
# Security & Access Control
# ------------------------------------------------------------------------------
# Bootstrap Admin API Key (>= 24 chars). Generate: python -c "import secrets;print('medora_'+secrets.token_urlsafe(32))"
ADMIN_API_KEY=medora_admin_secret_key_1234567890abcdef

# Allowed frontend CORS origins (JSON array format)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","https://medora-ai-virid.vercel.app"]

# ------------------------------------------------------------------------------
# Mode Toggle (Offline Fakes vs. Live AI)
# ------------------------------------------------------------------------------
# Set to 'true' to run fully offline with deterministic mocks (no API keys required).
# Set to 'false' to use real Google Gemini, Sarvam Voice, and Qdrant APIs.
MOCK_EXTERNAL=false

# ------------------------------------------------------------------------------
# Google Gemini LLM & Embeddings (Agentic RAG)
# ------------------------------------------------------------------------------
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768

# ------------------------------------------------------------------------------
# Sarvam AI (Indian Multilingual Speech-to-Text & Text-to-Speech)
# ------------------------------------------------------------------------------
# Get your API key from Sarvam AI: https://www.sarvam.ai/
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_STT_MODEL=saaras:v3
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=auto
SARVAM_TTS_PACE=0.9

# ------------------------------------------------------------------------------
# Qdrant Vector Database
# ------------------------------------------------------------------------------
# Qdrant Cloud or Local Docker Qdrant (e.g. http://localhost:6333)
QDRANT_URL=https://your-cluster-id.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_COLLECTION=medora_records

# Optional local vector fallback path when Qdrant cloud key is omitted:
# QDRANT_LOCAL_PATH=./qdrant-data/live

# ------------------------------------------------------------------------------
# RAG & Clinical Extraction Guardrails
# ------------------------------------------------------------------------------
MIN_EXTRACTION_CONFIDENCE=0.80
RAG_TOP_K=8
RAG_SCORE_THRESHOLD=0.30
