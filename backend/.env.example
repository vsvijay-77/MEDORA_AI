# Copy to .env and fill in. NEVER commit .env.
ENVIRONMENT=development

# PostgreSQL or Supabase (Settings -> Database -> Connection string, "URI")
DATABASE_URL=postgresql+psycopg://medchronicle:medchronicle@localhost:5432/medchronicle
# DATABASE_URL=postgresql+psycopg://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
UPLOAD_DIR=./uploads

# Bootstrap admin key (>= 24 chars). Generate: python -c "import secrets;print('mc_'+secrets.token_urlsafe(32))"
ADMIN_API_KEY=
CORS_ORIGINS=["http://localhost:3000"]

# true = run fully offline with deterministic fakes (no keys needed)
MOCK_EXTERNAL=false

SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v3
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=auto
SARVAM_TTS_PACE=0.9

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768

# Qdrant Cloud: use the cluster URL with port 6333, and an API key from the Qdrant console
QDRANT_URL=https://b99cad3d-5abe-450c-b57d-86443d60834b.eu-west-1-0.aws.cloud.qdrant.io:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=medchronicle_records
# Optional: persistent local Qdrant until QDRANT_API_KEY is supplied.
# QDRANT_LOCAL_PATH=./qdrant-data/live

MIN_EXTRACTION_CONFIDENCE=0.8
RAG_TOP_K=8
RAG_SCORE_THRESHOLD=0.30
