# ==============================================================================
# MEDORA AI - Master Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BACKEND SERVICE CONFIGURATION (backend/.env)
# ------------------------------------------------------------------------------
ENVIRONMENT=development

# Database (SQLite by default, or PostgreSQL/Supabase)
DATABASE_URL=sqlite:///./medora.db
# DATABASE_URL=postgresql+psycopg://postgres:<password>@db.<ref>.supabase.co:5432/postgres

UPLOAD_DIR=./uploads
ADMIN_API_KEY=medora_admin_secret_key_1234567890abcdef
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","https://medora-ai-virid.vercel.app"]

# Toggle between deterministic offline fakes (true) and live AI models (false)
MOCK_EXTERNAL=false

# Google Gemini (Agentic RAG, Extraction, Grounding)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768

# Sarvam AI (Indian Multilingual Voice STT & TTS)
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_STT_MODEL=saaras:v3
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=auto
SARVAM_TTS_PACE=0.9

# Qdrant Vector Search Engine
QDRANT_URL=https://your-cluster-id.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_COLLECTION=medora_records
# QDRANT_LOCAL_PATH=./qdrant-data/live

# RAG Thresholds
MIN_EXTRACTION_CONFIDENCE=0.80
RAG_TOP_K=8
RAG_SCORE_THRESHOLD=0.30

# ------------------------------------------------------------------------------
# 2. FRONTEND APPLICATION CONFIGURATION (frontend/.env)
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000/api
